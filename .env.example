# =============================================================================
# SLRJ DIGITAL – PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# For Vercel Deployment & Meta WhatsApp Cloud API
# =============================================================================

# 1. DATABASE CONFIGURATION (Persistent External Storage)
# Required for Vercel Serverless: Use a managed PostgreSQL database (Neon, Supabase, Railway, RDS)
# Example: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/slrj_digital?sslmode=require"

# For local offline development only:
# DATABASE_URL="file:./dev.db"

# 2. APPLICATION URL & AUTHENTICATION
# On Vercel, set this to your production domain (e.g. https://slrjdigital.vercel.app or https://whatsapp.slrjdigital.in)
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"

# Generate a strong 32+ character random string for production JWT session signing
JWT_SECRET="generate_a_secure_random_64_character_hex_secret_key_here"

# 3. META WHATSAPP BUSINESS CLOUD API
# Obtain from https://developers.facebook.com/apps/ -> WhatsApp -> API Setup & Configuration
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_secret_verify_token_here"
WHATSAPP_APP_SECRET="your_meta_app_secret_from_app_settings_basic"
WHATSAPP_ACCESS_TOKEN="your_permanent_system_user_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id_here"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id_here"

# 4. OPTIONAL SENDER PROFILE & VERCEL CRON
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_DISPLAY_PHONE="+91 84669 74408"
WHATSAPP_VERIFIED_NAME="SLRJ DIGITAL"
CRON_SECRET="optional_secret_for_protecting_vercel_cron_endpoint"
