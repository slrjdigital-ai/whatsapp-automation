// SLRJ DIGITAL - Bulk WhatsApp Outreach & Marketing Automation Platform
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      @default("CAMPAIGN_OPERATOR") // SUPER_ADMIN, MARKETING_MANAGER, CAMPAIGN_OPERATOR
  status       String      @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  campaigns    Campaign[]
}

model Contact {
  id              String                  @id @default(cuid())
  fullName        String
  mobileNumber    String                  @unique // Normalized E.164 (e.g. +919876543210)
  countryCode     String                  // e.g. "91" or "IN"
  nationalNumber  String                  // e.g. "9876543210"
  businessName    String?
  email           String?
  category        String?                 // e.g. "Retail", "Corporate", "E-commerce", "SME"
  status          String                  @default("VALID") // VALID, INVALID, UNVERIFIED
  consentStatus   String                  @default("PENDING_VERIFICATION") // OPTED_IN, PENDING_VERIFICATION, OPTED_OUT
  consentSource   String?                 // WEBSITE_FORM, EXCEL_IMPORT, CUSTOMER_ENQUIRY, INBOUND_STOP, MANUAL_ADMIN
  consentDate     DateTime?               // Timestamp when consent was recorded/verified
  consentEvidence String?                 // Evidence reference (form id, contract ref, document id)
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  consents        ContactConsent[]
  campaignContacts CampaignContact[]
  messages        Message[]
  groups          ContactGroupMember[]

  @@index([mobileNumber])
  @@index([consentStatus])
  @@index([category])
}

model ContactGroup {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  color       String?              @default("#0f172a")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  members     ContactGroupMember[]
}

model ContactGroupMember {
  id         String       @id @default(cuid())
  contactId  String
  groupId    String
  createdAt  DateTime     @default(now())

  contact    Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group      ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([contactId, groupId])
  @@index([contactId])
  @@index([groupId])
}

model ContactConsent {
  id          String   @id @default(cuid())
  contactId   String
  status      String   // OPTED_IN, PENDING_VERIFICATION, OPTED_OUT
  source      String   // EXCEL_UPLOAD, WEBSITE_FORM, CUSTOMER_ENQUIRY, API, INBOUND_STOP, MANUAL_ADMIN
  evidence    String?  // Reference/proof/form id/agreement reference
  optInDate   DateTime?
  optOutDate  DateTime?
  notes       String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([status])
}

model SuppressionList {
  id           String   @id @default(cuid())
  mobileNumber String   @unique // Normalized E.164
  reason       String   // USER_STOP, MANUAL_ADMIN, INVALID_NUMBER, COMPLAINT, UNSUBSCRIBE
  notes        String?
  suppressedBy String?  // User ID or "SYSTEM_WEBHOOK"
  createdAt    DateTime @default(now())

  @@index([mobileNumber])
}

model WhatsAppAccount {
  id                 String    @id @default(cuid())
  accountName        String    @default("SLRJ DIGITAL Official")
  wabaId             String?   // WhatsApp Business Account ID
  phoneNumberId      String?   // Phone Number ID
  displayPhoneNumber String?   // e.g. +91 99999 99999
  verifiedName       String?   // e.g. "SLRJ DIGITAL"
  qualityRating      String?   @default("GREEN") // GREEN, YELLOW, RED, UNKNOWN
  messagingLimitTier String?   @default("TIER_1K") // TIER_50, TIER_250, TIER_1K, TIER_10K, TIER_100K, UNLIMITED
  accessToken        String?   // Permanent / System-User Token
  webhookVerifyToken String?   @default("slrj_digital_secure_wh_2026")
  appSecret          String?   // Meta App Secret for signature verification
  apiVersion         String    @default("v21.0")
  status             String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR
  isConnected        Boolean   @default(false)
  isDemoMode         Boolean   @default(false)
  isTestNumber       Boolean   @default(false)
  lastVerifiedAt     DateTime?
  lastSuccessfulRequestAt DateTime?
  lastApiError       String?
  lastApiErrorCode   String?
  lastWebhookReceivedAt   DateTime?
  lastWebhookPayload String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model MessageTemplate {
  id                String     @id @default(cuid())
  name              String     @unique // e.g. "slrj_digital_intro"
  displayName       String     // e.g. "SLRJ Digital - Business Introduction"
  category          String     // BUSINESS_INTRO, WEBSITE_DEV, ECOMMERCE, MOBILE_APP, MARKETING, FOLLOW_UP, FEEDBACK, SPECIAL_OFFER
  language          String     @default("en")
  metaTemplateId    String?
  status            String     @default("APPROVED") // APPROVED, PENDING, REJECTED, DRAFT
  headerType        String?    @default("NONE") // NONE, TEXT, IMAGE, VIDEO, DOCUMENT
  headerContent     String?
  bodyText          String
  footerText        String?
  buttonsJson       String?    // JSON string array of buttons
  sampleValuesJson  String?    // JSON sample variables
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  campaigns         Campaign[]
}

model Campaign {
  id                String            @id @default(cuid())
  name              String
  description       String?
  status            String            @default("DRAFT") // DRAFT, SCHEDULED, RUNNING, PAUSED, COMPLETED, CANCELLED, FAILED
  type              String            @default("TEMPLATE") // TEMPLATE, CUSTOM_SESSION
  templateId        String?
  messageBody       String?
  mediaUrl          String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  totalContacts     Int               @default(0)
  eligibleContacts  Int               @default(0)
  sentCount         Int               @default(0)
  deliveredCount    Int               @default(0)
  readCount         Int               @default(0)
  failedCount       Int               @default(0)
  pendingCount      Int               @default(0)
  isDemo            Boolean           @default(false)
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  template          MessageTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaignContacts  CampaignContact[]
  messages          Message[]
  automationJobs    AutomationJob[]

  @@index([status])
  @@index([createdAt])
}

model CampaignContact {
  id                String    @id @default(cuid())
  campaignId        String
  contactId         String
  status            String    @default("PENDING") // PENDING, QUEUED, SUBMITTED, SENDING, SENT, DELIVERED, READ, FAILED, SKIPPED
  whatsappMessageId String?
  errorMessage      String?
  errorCode         String?
  retryCount        Int       @default(0)
  submittedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([whatsappMessageId])
}

model Message {
  id                String              @id @default(cuid())
  whatsappMessageId String?             @unique
  campaignId        String?
  contactId         String?
  recipientNumber   String              // E.164 format (e.g. +919876543210 or 919876543210)
  senderNumber      String?             // Sender phone number (displayPhoneNumber / Phone ID)
  direction         String              @default("OUTBOUND") // OUTBOUND, INBOUND
  messageType       String              @default("TEMPLATE") // TEMPLATE, TEXT, INTERACTIVE, MEDIA
  templateName      String?             // Template name if template message
  content           String
  submissionStatus  String              @default("PENDING") // PENDING, SUBMITTED, FAILED
  deliveryStatus    String              @default("QUEUED") // QUEUED, SUBMITTED, SENT, DELIVERED, READ, FAILED, RECEIVED
  status            String              @default("QUEUED") // Mirror of deliveryStatus for backwards compatibility
  errorCode         String?             // Error code (Meta code or internal)
  errorDescription  String?             // Human-readable error description
  rawPayload        String?             // JSON Request payload
  rawResponse       String?             // JSON Meta API response
  metadata          String?             // JSON Webhook metadata
  submittedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  campaign          Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact           Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  events            MessageStatusEvent[]

  @@index([whatsappMessageId])
  @@index([recipientNumber])
  @@index([submissionStatus])
  @@index([deliveryStatus])
  @@index([status])
  @@index([campaignId])
}

model MessageStatusEvent {
  id                String   @id @default(cuid())
  messageId         String?
  whatsappMessageId String?
  eventType         String   // QUEUED, SENT, DELIVERED, READ, FAILED, RECEIVED
  timestamp         DateTime @default(now())
  errorDetails      String?  // JSON or text
  rawPayload        String?  // JSON
  createdAt         DateTime @default(now())

  message           Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([whatsappMessageId])
  @@index([eventType])
}

model ScheduledCampaign {
  id             String    @id @default(cuid())
  campaignId     String
  executeAt      DateTime
  cronExpression String?
  status         String    @default("PENDING") // PENDING, EXECUTED, CANCELLED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([executeAt, status])
}

model AutomationJob {
  id          String    @id @default(cuid())
  campaignId  String
  jobType     String    @default("CAMPAIGN_BATCH_SEND")
  status      String    @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, PAUSED
  progress    Int       @default(0) // 0 - 100 percentage
  errorLog    String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // CONTACT_UPLOAD, CAMPAIGN_LAUNCH, CAMPAIGN_PAUSE, TEMPLATE_CREATE, SETTINGS_UPDATE, SUPPRESSION_ADD
  entityType String   // Contact, Campaign, WhatsAppAccount, SuppressionList, MessageTemplate
  entityId   String?
  details    String?  // JSON details
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
